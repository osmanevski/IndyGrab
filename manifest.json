{
  "manifest_version": 3,
  "name": "IndyGrab.VO",
  "version": "1881",
  "description": "Yerel çalışan, AI destekli Amazon ve eBay ürün araştırma aracı.",
  "permissions": [
    "storage",
    "activeTab",
    "cookies",
    "bookmarks",
    "tabs",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.com.au/*",
    "https://www.ebay.com/*",
    "https://i.ebayimg.com/*",
    "https://m.media-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*",
    "https://my.easync.io/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "20": "icons/icon20.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "20": "icons/icon20.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.au/*"
      ],
      "js": [
        "content_amazon.js",
        "content_amazon_paste.js"
      ]
    },
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://www.ebay.com/sch/*"
      ],
      "js": [
        "content_ebay.js"
      ]
    },
    {
      "matches": [
        "https://my.easync.io/stores/*/orders/*"
      ],
      "js": [
        "content_easync.js"
      ],
      "css": [
        "custom_styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*.png",
        "mixer.html",
        "mixer.js",
        "blacklist.html",
        "blacklist.js",
        "research.html",
        "research.js",
        "popup.js",
        "theme.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
